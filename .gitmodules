[submodule "vendor/gstreamer"]
	path = vendor/gstreamer
	url = https://github.com/GStreamer/gstreamer.git
[submodule "vendor/gtk"]
	path = vendor/gtk
	url = https://github.com/GNOME/gtk.git
[submodule "vendor/glib"]
	path = vendor/glib
	url = https://github.com/GNOME/glib.git
