	path = vendor/gst-plugins-base
	url = https://github.com/GStreamer/gst-plugins-base.git
[submodule "vendor/gst-plugins-good"]
	path = vendor/gst-plugins-good
	url = https://github.com/GStreamer/gst-plugins-good.git
[submodule "vendor/gst-plugins-bad"]
	path = vendor/gst-plugins-bad
	url = https://github.com/GStreamer/gst-plugins-bad.git
[submodule "vendor/gst-plugins-ugly"]
	path = vendor/gst-plugins-ugly
	url = https://github.com/GStreamer/gst-plugins-ugly.git
[submodule "vendor/spdlog"]
	path = vendor/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "vendor/aravis"]
	path = vendor/aravis
